# Server Configuration
PORT=5100
NODE_ENV=development

# Frontend/Client URL (CORS Configuration)
CLIENT_URL=http://localhost:5173

# Database & Cache Configuration
MONGO_URI=mongodb+srv://<DB_USERNAME>:<DB_PASSWORD>@cluster.mongodb.net/intellmeet?retryWrites=true&w=majority
REDIS_URL=redis://127.0.0.1:6379

# AI Service (Google Gemini API)
GEMINI_API_KEY=your_gemini_api_key_here

# JWT Authentication Secrets
JWT_SECRET=your_jwt_secret_minimum_32_characters_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_minimum_32_characters_here
JWT_ACCESS_TOKEN_EXPIRY=7d
JWT_REFRESH_TOKEN_EXPIRY=1d

# Cloudinary Media Storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_FOLDER=IntellMeet_AI_Powered_Meeting

# Email SMTP Notification Configuration (Gmail App Password)
SMTP_SERVICE=gmail
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
EMAIL_FROM="IntellMeet <your_email@gmail.com>"
